[Unit]
Description=QnA Portal AI job discovery agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/QnA-Portal
EnvironmentFile=/etc/qna-portal/job-agent.env
ExecStart=/usr/bin/node backend/scripts/discover-jobs-agent.js
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/QnA-Portal

[Install]
WantedBy=multi-user.target

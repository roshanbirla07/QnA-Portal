# Store the real file at /etc/qna-portal/job-agent.env with chmod 600.
OPENAI_API_KEY=replace_me
QNA_MCP_URL=https://your-domain.example/mcp
QNA_MCP_API_KEY=replace_me

# Optional tuning
QNA_JOB_AGENT_MODEL=gpt-6-luna
QNA_JOB_AGENT_MAX_JOBS=20
QNA_JOB_AGENT_LOOKBACK_DAYS=7
QNA_JOB_AGENT_REGION=India
